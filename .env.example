# Server
PORT=5000
NODE_ENV=development

# CORS — comma separated list of allowed origins for the ADMIN APIs
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK credentials (from your service account JSON)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the literal \n escapes exactly as they appear in the JSON file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Optional: alternative to the three vars above — absolute path to the service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Admin authentication
# Generate a strong secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
TOKEN_EXPIRES_IN=12h

# Used by `npm run create-admin` to create/reset the dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator

# Optional: prefix used for generated license keys (4 uppercase chars recommended)
LICENSE_KEY_PREFIX=OPEZ

# --- Email sending (optional) -----------------------------------------------
# Firebase cannot send email; these are the SMTP details of a mail provider.
# Leave blank and the console falls back to opening your own mail client.
# Gmail / Google Workspace: smtp.gmail.com, port 587, and an App Password
# (NOT your normal password) from https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: true forces implicit TLS. Leave blank to infer from the port.
SMTP_SECURE=
# The From address shown to recipients. Defaults to SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Opezee Licenses


# --- Dashboard (Vite) --------------------------------------------------------
# The dashboard calls a relative /api: in production Express serves the build
# from the same origin, and in development Vite proxies /api to PORT above.
# Only set this to point the dashboard at a different host entirely.
# VITE_API_BASE_URL=
